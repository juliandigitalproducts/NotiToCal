<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Pipeline keeps the CPU awake while a message is analysed (C32: declared here, not only via WorkManager). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.READ_CALENDAR" />
  <uses-permission android:name="android.permission.WRITE_CALENDAR" />
  <!-- Full photo access is needed: new screenshots in the chosen folders are analysed automatically, and photos taken
       with the quick-capture widget are evaluated right away. "Selected photos only" would miss every new screenshot. -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- Optional hourly location samples for the on-device location history (only when switched on). -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <!-- OpenTasks / Tasks.org / jtx Board task providers -->
  <uses-permission android:name="org.dmfs.permission.READ_TASKS" />
  <uses-permission android:name="org.dmfs.permission.WRITE_TASKS" />
  <uses-permission android:name="org.tasks.permission.READ_TASKS" />
  <uses-permission android:name="org.tasks.permission.WRITE_TASKS" />

  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="text/plain" />
    </intent>
    <intent>
      <action android:name="android.intent.action.INSERT" />
      <data android:mimeType="vnd.android.cursor.item/event" />
    </intent>
    <package android:name="com.google.android.apps.tasks" />
    <package android:name="com.samsung.android.app.reminder" />
    <provider android:authorities="org.dmfs.tasks" />
    <provider android:authorities="org.tasks.opentasks" />
  </queries>

  <application
    android:name=".NotiToCalApp"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:networkSecurityConfig="@xml/network_security_config"
    android:theme="@style/Theme.NotiToCal"
    tools:targetApi="37">

    <!-- All screens are Compose and adapt to size changes by themselves, so turning or resizing the device does not
         recreate them: running work (analysis, re-sorting, AI checks) and open dialogs simply continue. -->
    <activity
      android:name=".ui.MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
      android:exported="true"
      android:launchMode="singleTop"
      android:windowSoftInputMode="adjustResize"
      android:theme="@style/Theme.NotiToCal.Splash">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService.ACTION_SETTINGS_HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Share text, screenshots/images and voice memos into NotiToCal. -->
    <activity
      android:name=".capture.ShareActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
      android:exported="true"
      android:excludeFromRecents="true"
      android:label="@string/share_label"
      android:theme="@style/Theme.NotiToCal.Translucent">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="video/mp4" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/calendar" />
      </intent-filter>
    </activity>

    <service
      android:name=".capture.NotificationCaptureService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
      <meta-data
        android:name="android.service.notification.default_filter_types"
        android:value="conversations|alerting" />
    </service>

    <receiver
      android:name=".notify.ActionReceiver"
      android:exported="false" />

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

    <activity
      android:name=".widget.QuickCaptureActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@style/Theme.NotiToCal.Translucent" />

    <receiver
      android:name=".widget.VoiceMemosWidgetProvider"
      android:exported="true"
      android:label="@string/widget_voice_memos_name">
      <!-- Refresh buttons use explicit intents, so no custom action is exported to other apps. -->
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_voice_memos_info" />
    </receiver>

    <service
      android:name=".widget.VoiceMemosWidgetService"
      android:permission="android.permission.BIND_REMOTEVIEWS"
      android:exported="false" />

    <receiver
      android:name=".widget.UnfilteredVoiceMemosWidgetProvider"
      android:exported="true"
      android:label="@string/widget_voice_memos_unfiltered_name">
      <!-- Refresh buttons use explicit intents, so no custom action is exported to other apps. -->
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_voice_memos_unfiltered_info" />
    </receiver>

    <service
      android:name=".widget.UnfilteredVoiceMemosWidgetService"
      android:permission="android.permission.BIND_REMOTEVIEWS"
      android:exported="false" />

    <!-- Settings of a home screen widget (opened by the launcher when it is placed or customised). -->
    <activity
      android:name=".widget.WidgetConfigActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
      android:exported="true"
      android:excludeFromRecents="true"
      android:theme="@style/Theme.NotiToCal">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <receiver
      android:name=".widget.QuickCameraWidgetProvider"
      android:exported="true"
      android:label="@string/widget_quick_camera_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_quick_camera_info" />
    </receiver>


  </application>
</manifest>
