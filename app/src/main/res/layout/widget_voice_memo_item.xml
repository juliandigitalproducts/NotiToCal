<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/memo_item_container"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/widget_chip_bg"
  android:orientation="vertical"
  android:padding="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/memo_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      tools:text="03.11 14:30"
      android:textColor="@color/widget_accent"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/memo_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:singleLine="true"
      android:maxLines="1"
      android:ellipsize="end"
      tools:text="📅 Termin"
      android:textColor="@color/widget_badge"
      android:textSize="11sp"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/memo_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    tools:text="Memo Text Transkript…"
    android:textColor="@color/widget_text"
    android:textSize="12sp" />

</LinearLayout>
