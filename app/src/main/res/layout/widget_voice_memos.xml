<!-- Shared by the filtered and the unfiltered voice memo widget (the title is set in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <!-- Separate layer, so the opacity setting fades only the background and not the text. -->
  <ImageView
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/widget_bg" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp">

      <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/widget_buttons"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_memos_title"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
          android:id="@+id/btn_photo_event"
          android:layout_width="wrap_content"
          android:layout_height="28dp"
          android:layout_marginEnd="6dp"
          android:background="@drawable/widget_chip_bg"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="8dp"
          android:paddingEnd="8dp">

          <ImageView
            android:id="@+id/btn_photo_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_camera_accent" />

          <TextView
            android:id="@+id/btn_photo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/widget_photo_event"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
          android:id="@+id/btn_open_app"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_marginEnd="2dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/widget_open_app"
          android:padding="5dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_widget_open" />

        <ImageButton
          android:id="@+id/btn_refresh"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/widget_refresh"
          android:padding="4dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_widget_refresh" />
      </LinearLayout>
    </RelativeLayout>

    <TextView
      android:id="@+id/widget_memos_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:text="@string/widget_memos_empty"
      android:textColor="@color/widget_text_secondary"
      android:textSize="12sp"
      android:visibility="gone" />

    <ListView
      android:id="@+id/widget_memos_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@null"
      android:dividerHeight="6dp" />
  </LinearLayout>
</FrameLayout>
